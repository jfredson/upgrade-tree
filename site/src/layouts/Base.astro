---
// The page shell, as the Sentient Horizons design standard sets it (design/README.md,
// sections 6 to 8): theme script before first paint, the top bar, the footer with its four
// lines and the attribution line with real provenance, then the subject notice John ruled for
// this site on 2026-10-17 (one line, in the place and register of Outrunning Ageing's medical
// notice), ending with the parent line. Built from The Belt Equation's Base.astro on
// 2026-10-16. No backdrop: this site wears the Plate skin (src/styles/skin.css), paper and
// ink, and the figure is the picture.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { tree, REPO } from '../lib/tree';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string; // a page's own preview picture (a news post's card); the site's otherwise
}

const {
  title = 'The Upgrade Tree',
  description = 'How much of a human being can we change with technology today? A public count of the upgrades that have reached a first human, a clinic, or wide use, branch by branch, and a watch on the link between brains and machines.',
  noindex = false,
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The preview picture link cards show (site/public/social-preview-2026-10-21.png, made by scripts/social-image.mjs); an absolute address, as the tags require.
const socialImage = new URL(image ?? '/social-preview-2026-10-21.png', Astro.site).href;
const currentYear = new Date().getFullYear();
// "16 October 2026" for the footer; the design standard writes dates out there.
const longDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
};
const c = tree.counts;
const builtFrom = `a record of ${c.upgrades} upgrade${c.upgrades === 1 ? '' : 's'} across seven branches, ${c.first_human_or_beyond} of them tried in at least one person`;
// Bump when the icon set changes, so browsers that keep their own copy of the icon (Safari above
// all) fetch the new one (2026-10-23, family-wide on John's word). The same tag is in
// public/site.webmanifest.
const iconVersion = '2';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set the theme before first paint so there is no flash on load. Light is the default on this site (the Plate skin, ruled 2026-10-16); dark only when the visitor asks for it. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <meta id="theme-color-meta" name="theme-color" content="#f3eee3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Andrew Fredrickson" />
    <link rel="author" href="https://johnandrewfredrickson.com/" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${iconVersion}`} />
    <link rel="alternate" type="application/rss+xml" title="The Upgrade Tree · News" href="/news/feed.xml" />
    <link rel="icon" type="image/png" sizes="32x32" href={`/favicon-32.png?v=${iconVersion}`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`/favicon-16.png?v=${iconVersion}`} />
    <link rel="icon" href={`/favicon.ico?v=${iconVersion}`} sizes="any" />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${iconVersion}`} />
    <link rel="manifest" href={`/site.webmanifest?v=${iconVersion}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Upgrade Tree" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {!image && <meta property="og:image:alt" content="The Upgrade Tree: How much of a human being can we change with technology today?" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <Nav />
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <span class="footer-brand">The Upgrade Tree</span>
          <p class="footer-tag">A public count of how much of a human being we can change with technology today, and a watch on the link between brains and machines.</p>
          <p class="footer-links">
            <a href="/branches/">The seven branches</a>
            <a href="/claims/">The claims</a>
            <a href="/reading/">This week's reading</a>
            <a href="/about/">About</a>
            <a href="/about/#method">How the numbers are worked out</a>
            <a href="/about/#story">The story so far</a>
            <a href="/disagree/">Feedback</a>
            <a href={REPO} rel="noopener">Source on GitHub</a>
          </p>
          <p class="footer-meta">
            © {currentYear} <a href="https://johnandrewfredrickson.com/" rel="author">John Andrew Fredrickson</a>. Last built {longDate(tree.exported_on)}{tree.commit ? ` (version ${tree.commit})` : ''} from {builtFrom}. Free to reuse with credit (<a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>); code under the MIT licence. Please credit as: <cite>The Upgrade Tree</cite>, by John Andrew Fredrickson, a Sentient Horizons project, <a href="https://theupgradetree.com/">theupgradetree.com</a>.
          </p>
          <p class="footer-notice">This site records what has been shown and what has been promised about changing a human being with technology. It recommends nothing, and nothing on it is medical advice.</p>
          <p class="footer-parent"><a href="https://sentient-horizons.com/projects/" rel="noopener">A Sentient Horizons project.</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
