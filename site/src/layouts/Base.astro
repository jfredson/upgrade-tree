---
// The page shell, as the Sentient Horizons design standard sets it (design/README.md,
// sections 6 to 8): theme script before first paint, the top bar, the footer with its four
// lines and the attribution line with real provenance, ending with the parent line.
// Built from The Belt Equation's Base.astro on 2026-10-16. No backdrop: this site wears the
// Plate skin (src/styles/skin.css), paper and ink, and the figure is the picture.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { tree, REPO } from '../lib/tree';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'The Upgrade Tree',
  description = 'How much of a human being can we change on purpose today? A public count of the upgrades that have reached a first human, a clinic, or wide use, branch by branch, and a watch on the link between brains and machines.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const currentYear = new Date().getFullYear();
// "16 October 2026" for the footer; the design standard writes dates out there.
const longDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
};
const c = tree.counts;
const builtFrom = `a record of ${c.upgrades} upgrade${c.upgrades === 1 ? '' : 's'} across seven branches, ${c.first_human_or_beyond} of them tried in at least one person`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set the theme before first paint so there is no flash on load. Light is the default on this site (the Plate skin, ruled 2026-10-16); dark only when the visitor asks for it. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <meta id="theme-color-meta" name="theme-color" content="#f3eee3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Fredrickson" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Upgrade Tree" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <Nav />
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <span class="footer-brand">The Upgrade Tree</span>
          <p class="footer-tag">A public count of how much of a human being we can change on purpose today, and a watch on the link between brains and machines.</p>
          <p class="footer-links">
            <a href="/branches/">The seven branches</a>
            <a href="/reading/">This week's reading</a>
            <a href="/method/">How the numbers are worked out</a>
            <a href="/story/">The story so far</a>
            <a href="/disagree/">Disagree with something</a>
            <a href={REPO} rel="noopener">Source on GitHub</a>
          </p>
          <p class="footer-meta">
            © {currentYear} John Fredrickson. Last built {longDate(tree.exported_on)}{tree.commit ? ` (version ${tree.commit})` : ''} from {builtFrom}. Free to reuse with credit (<a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>); code under the MIT licence.
          </p>
          <p class="footer-parent"><a href="https://sentient-horizons.com" rel="noopener">A Sentient Horizons project.</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
