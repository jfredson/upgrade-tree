---
// The human figure on the home page: an original, simple drawing with one clickable region per
// branch, shaded by the furthest stage any upgrade under that branch has reached (grey when
// nothing is recorded). Drawn 2026-10-16. Shading uses the site's data colour (--accent-3) at
// rising strength; see the .figure rules in styles/global.css.
import { tree, type Branch } from '../lib/tree';

const region = (key: string): Branch => tree.branches.find((b) => b.figure_region === key)!;
const cls = (b: Branch) => `region ${b.furthest_rank === null ? 'stage-none' : `stage-${b.furthest_rank}`}`;
const label = (b: Branch) =>
  b.furthest_label
    ? `${b.name}: ${b.count} upgrade${b.count === 1 ? '' : 's'}, furthest stage reached ${b.furthest_label.toLowerCase()}`
    : `${b.name}: nothing recorded yet`;

const senses = region('senses');
const movement = region('movement');
const mind = region('mind');
const mood = region('mood');
const lifespan = region('lifespan');
const inheritance = region('inheritance');
const link = region('link');
---

<svg class="figure" viewBox="0 0 350 365" role="img" aria-labelledby="figure-title" xmlns="http://www.w3.org/2000/svg">
  <title id="figure-title">A human figure with seven regions, one per branch, shaded by the furthest stage reached under each</title>

  {/* Memory and thinking: the top of the head */}
  <a href={mind.path} class={cls(mind)} aria-label={label(mind)}>
    <title>{label(mind)}</title>
    <path d="M146,58 A34,34 0 0 1 214,58 Z" />
  </a>
  <text class="label" x="180" y="16" text-anchor="middle">Memory and thinking</text>

  {/* Senses: the face and ears */}
  <a href={senses.path} class={cls(senses)} aria-label={label(senses)}>
    <title>{label(senses)}</title>
    <path d="M146,58 A34,34 0 0 0 214,58 Z" />
    <circle cx="145" cy="66" r="5" />
    <circle cx="215" cy="66" r="5" />
    <circle class="outline" cx="170" cy="68" r="2.5" />
    <circle class="outline" cx="190" cy="68" r="2.5" />
  </a>
  <text class="label" x="130" y="72" text-anchor="end">Senses</text>

  {/* Neck */}
  <rect class="outline" x="172" y="92" width="16" height="8" rx="3" />

  {/* The link to machines: a chip at the side of the head, a wire, a machine */}
  <path class="wire" d="M188,40 H258 V64" />
  <a href={link.path} class={cls(link)} aria-label={label(link)}>
    <title>{label(link)}</title>
    <rect x="176" y="34" width="12" height="12" rx="2" />
    <rect x="256" y="64" width="56" height="38" rx="6" />
    <rect class="outline" x="264" y="72" width="40" height="18" rx="2" />
  </a>
  <text class="label" x="284" y="118" text-anchor="middle">The link to machines</text>

  {/* Mood and drive: the chest */}
  <a href={mood.path} class={cls(mood)} aria-label={label(mood)}>
    <title>{label(mood)}</title>
    <rect x="148" y="98" width="64" height="54" rx="12" />
  </a>
  <text class="label" x="112" y="128" text-anchor="end">Mood and drive</text>

  {/* Lifespan and repair: the belly, the body's core */}
  <a href={lifespan.path} class={cls(lifespan)} aria-label={label(lifespan)}>
    <title>{label(lifespan)}</title>
    <rect x="148" y="154" width="64" height="60" rx="12" />
  </a>
  <text class="label" x="112" y="190" text-anchor="end">Lifespan and repair</text>

  {/* Movement and body: arms and legs */}
  <a href={movement.path} class={cls(movement)} aria-label={label(movement)}>
    <title>{label(movement)}</title>
    <rect x="121" y="106" width="18" height="100" rx="9" />
    <rect x="221" y="106" width="18" height="100" rx="9" />
    <rect x="155" y="214" width="22" height="120" rx="11" transform="rotate(4 166 214)" />
    <rect x="183" y="214" width="22" height="120" rx="11" transform="rotate(-4 194 214)" />
  </a>
  <text class="label" x="180" y="352" text-anchor="middle">Movement and body</text>

  {/* Inheritance: a child at the hand */}
  <a href={inheritance.path} class={cls(inheritance)} aria-label={label(inheritance)}>
    <title>{label(inheritance)}</title>
    <circle cx="108" cy="236" r="12" />
    <rect x="96" y="250" width="24" height="46" rx="10" />
  </a>
  <text class="label" x="108" y="314" text-anchor="middle">Inheritance</text>
</svg>
