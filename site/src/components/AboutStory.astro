---
// The story so far, moved here from pages/story.astro on 2026-10-21 when the top bar was simplified
// (tracker pattern rule 4.21, ruled by John that day). The text is unchanged; it is the second part of /about/.
// The story so far: the changelog, rendered day by day from CHANGELOG.md (scripts/export.py).
import { changelog, longDate, REPO } from '../lib/tree';
import { datedPosts, postPath } from '../lib/news';
const newsPosts = await datedPosts();
const postsFor = (date: string) => newsPosts.filter((p) => p.data.date === date); // rule 4.14
---

  <section class="hero about-part" id="story">
    <p class="eyebrow">The story so far</p>
    <h2 class="about-h">Every change, dated</h2>
    <p class="lede">
      {changelog.intro || 'Newest first. Each day lists what changed in the record, the rules, or the site.'}
    </p>
  </section>

  <section class="section narrow">
    <ul class="days">
      {changelog.days.map((d) => (
        <li id={d.date}>
          <h2><a href={`#${d.date}`} class="u-link-reset" style="color: inherit;">{longDate(d.date)}</a></h2>
          <ul>
            {d.items.map((item) => <li>{item}</li>)}
            {postsFor(d.date).map((p) => <li class="in-the-news-line">In the news: <a href={postPath(p)}>{p.data.title}</a>.</li>)}
          </ul>
        </li>
      ))}
    </ul>
    <p class="dim" style="font-size: 14px; margin-top: 24px;">
      This page is the repository's changelog as written: <a href={`${REPO}/blob/main/CHANGELOG.md`} rel="noopener">CHANGELOG.md</a>.
    </p>
  </section>

