---
// Site navigation, the shape the Sentient Horizons design standard sets (design/README.md,
// section 6): the spine of the site in heavier ink, the reference pages lighter after a rule,
// the theme toggle last. Collapses to a menu on small screens. Copied from The Belt Equation's
// Nav.astro on 2026-10-16. The page names follow the tracker pattern John ruled the same day:
// the spine is Home, Branches, this week's reading and the story so far; the method page and
// the disagree page sit in the lighter tier. "This week's reading" joined the spine on
// 2026-10-16 with the first weekly reading (docs/weekly-reading.md).
const path = Astro.url.pathname;
const primary = [
  { href: '/', label: 'Home' },
  { href: '/branches/', label: 'Branches' },
  { href: '/reading/', label: "This week's reading" },
  { href: '/story/', label: 'The story so far' },
];
const secondary = [
  { href: '/method/', label: 'How the numbers are worked out' },
  { href: '/disagree/', label: 'Disagree with something' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">The Upgrade Tree</a>
    <button type="button" class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg class="ico-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      <svg class="ico-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <nav class="navlinks" id="site-nav">
      {primary.map((l) => (
        <a href={l.href} class={`nav-primary ${isActive(l.href) ? 'active' : ''}`}>{l.label}</a>
      ))}
      <span class="nav-divider" aria-hidden="true"></span>
      {secondary.map((l) => (
        <a href={l.href} class={`nav-secondary ${isActive(l.href) ? 'active' : ''}`}>{l.label}</a>
      ))}
      <button type="button" class="theme-toggle" aria-label="Toggle light and dark theme" title="Toggle theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    var btn = header && header.querySelector('.nav-toggle');
    var menu = document.getElementById('site-nav');
    if (!btn || !menu) return;
    function setOpen(open) {
      header.classList.toggle('nav-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    btn.addEventListener('click', function () {
      setOpen(!header.classList.contains('nav-open'));
    });
    menu.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false);
    });
    window.addEventListener('resize', function () {
      if (window.innerWidth > 1080) setOpen(false); // the bar collapses up to 1080 on this site (global.css, the top bar with six page names)
    });
  })();
</script>

<script is:inline>
  (function () {
    var btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    var meta = document.getElementById('theme-color-meta');
    var COLORS = { dark: '#08070f', light: '#faf9f7' };
    function sync(theme) {
      document.documentElement.dataset.theme = theme;
      if (meta) meta.setAttribute('content', COLORS[theme] || COLORS.dark);
    }
    sync(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
    btn.addEventListener('click', function () {
      var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      try { localStorage.setItem('theme', next); } catch (e) {}
      sync(next);
    });
  })();
</script>
