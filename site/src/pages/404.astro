---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — The Upgrade Tree" description="This page does not exist, or does not exist yet." noindex>
  <section class="hero">
    <p class="eyebrow">404</p>
    <h1>Nothing on this branch</h1>
    <p class="lede">
      The page you are looking for does not exist, or does not exist yet. An upgrade's address never
      changes once it is published, so a link that fails probably never pointed at one.
    </p>
    <p>
      Try the <a href="/">home page</a> or <a href="/branches/">the seven branches</a>.
    </p>
  </section>
</Base>
