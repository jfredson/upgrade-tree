{
  // Cloudflare Workers config: a static-assets deployment, the same pattern as
  // beltequation.com, thequietgalaxy.com and sentient-horizons.com. theupgradetree.com and
  // upgradetree.com were registered by John on Cloudflare on 2026-10-16 and attached as custom
  // domains the same evening; the routes below keep the config in step with what is deployed
  // so a deploy from a fresh machine does not drop them. worker/redirect.js forwards every
  // address but theupgradetree.com (www, and upgradetree.com with its www) to the same page
  // at theupgradetree.com, so there is one address for citations.
  "name": "theupgradetree",
  "main": "worker/redirect.js",
  "compatibility_date": "2026-10-01",
  // Keep the workers.dev preview address alongside the custom domains, as the sister sites do.
  "workers_dev": true,
  "routes": [
    { "pattern": "theupgradetree.com", "custom_domain": true },
    { "pattern": "www.theupgradetree.com", "custom_domain": true },
    { "pattern": "upgradetree.com", "custom_domain": true },
    { "pattern": "www.upgradetree.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
